# Copy to .env.local for local development. Real values live in Vercel (vercel env pull).

# Supabase (local stack: run `supabase start`, then `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PORTAL_CONFIGURATION=bpc_...   # printed by `pnpm stripe:setup`

# Demo sandboxes and cron
CRON_SECRET=
DEMO_IP_SALT=

# AI revision checklists. With a free Google AI Studio key they use Gemini (no card needed):
# GOOGLE_GENERATIVE_AI_API_KEY=
# Without it they go through Vercel AI Gateway (OIDC on Vercel, or AI_GATEWAY_API_KEY locally).
# RELAYDESK_AI_MODEL=gemini-3.5-flash-lite
# RELAYDESK_AI_FAKE=1   # build checklists straight from the notes, with no model (tests)
